<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="beslissingen" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="nl.ampere.controller.BeslissingenController">

    <Label styleClass="titel" text="Beslissingen" />

    <!-- witte kaart met de filterbalk en de tabel -->
    <VBox spacing="16" styleClass="kaart">

        <!-- filterbalk -->
        <HBox alignment="BOTTOM_LEFT" fillHeight="false" spacing="16">
            <HBox styleClass="tabknoppen">
                <Button styleClass="actief" text="Pauzes" />
                <Button text="Voorrang" />
            </HBox>

            <!-- datum -->
            <VBox spacing="6">
                <Label styleClass="veldnaam" text="Datum" />
                <TextField prefWidth="170" text="15-11-2026" />
            </VBox>

            <!-- apparaat -->
            <VBox spacing="6">
                <Label styleClass="veldnaam" text="Apparaat" />
                <ComboBox prefWidth="200" promptText="Alle apparaten" />
            </VBox>

            <!-- lege ruimte, zodat het aantal helemaal rechts komt -->
            <Region HBox.hgrow="ALWAYS" />

            <Label styleClass="aantal" text="2 pauzes" />
        </HBox>

    </VBox>

</VBox>
