<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nl.ampere.controller.BeheerController" fitToWidth="true" styleClass="beheer-scroll">
 <content>
  <VBox styleClass="beheer" spacing="20" minWidth="960">
   <Label text="Beheer" styleClass="beheer-paginatitel"/>
   <VBox styleClass="beheer-kaart" spacing="16">
    <HBox alignment="CENTER_LEFT"><Label text="Deze week" styleClass="beheer-kop"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="weekPeriode" styleClass="beheer-subtiel"/></HBox>
    <HBox spacing="12">
     <VBox styleClass="beheer-statistiek" spacing="8" HBox.hgrow="ALWAYS" prefWidth="250"><Label text="Pauzes" styleClass="beheer-subtiel"/><Label fx:id="aantalPauzes" styleClass="beheer-getal"/></VBox>
     <VBox styleClass="beheer-statistiek" spacing="8" HBox.hgrow="ALWAYS" prefWidth="250"><Label text="Totale pauzeduur" styleClass="beheer-subtiel"/><Label fx:id="pauzeduur" styleClass="beheer-getal"/></VBox>
     <VBox styleClass="beheer-statistiek" spacing="8" HBox.hgrow="ALWAYS" prefWidth="250"><Label text="Voorrang gebruikt" styleClass="beheer-subtiel"/><Label fx:id="aantalVoorrang" styleClass="beheer-getal"/></VBox>
     <VBox styleClass="beheer-statistiek" spacing="8" HBox.hgrow="ALWAYS" prefWidth="250"><Label text="Limiet overschreden" styleClass="beheer-subtiel"/><Label fx:id="aantalOverschrijdingen" styleClass="beheer-getal"/><Label fx:id="overschrijdingToelichting" styleClass="beheer-subtiel"/></VBox>
    </HBox>
   </VBox>
   <VBox styleClass="beheer-kaart" spacing="16">
    <Label text="Limiet van het gebouw" styleClass="beheer-kop"/>
    <HBox spacing="36" alignment="TOP_LEFT">
     <VBox spacing="6" prefWidth="180"><Label text="Limiet (kW)" labelFor="$limiet"/><TextField fx:id="limiet"/><Label fx:id="limietFout" styleClass="beheer-fout" wrapText="true" visible="false" managed="false"/></VBox>
     <VBox spacing="6" prefWidth="180"><Label text="Weer aan onder (kW)" labelFor="$weerAan"/><TextField fx:id="weerAan"/><Label fx:id="weerAanFout" styleClass="beheer-fout" wrapText="true" visible="false" managed="false"/></VBox>
     <VBox spacing="6" prefWidth="180"><Label text="Max. voorrang (uur)" labelFor="$maxVoorrang"/><TextField fx:id="maxVoorrang"/><Label fx:id="voorrangFout" styleClass="beheer-fout" wrapText="true" visible="false" managed="false"/></VBox>
     <VBox spacing="6"><Label text=" "/><Button text="Opslaan" onAction="#controleerInstellingen" styleClass="beheer-primair"/></VBox>
    </HBox>
    <VBox fx:id="instellingenBevestiging" styleClass="beheer-bevestiging" spacing="12" visible="false" managed="false">
     <Label text="Wijzigingen opslaan?" styleClass="beheer-kop"/><Label fx:id="instellingenSamenvatting" wrapText="true"/>
     <!-- Opslag wordt later aan de gegevenslaag gekoppeld. -->
     <HBox spacing="8"><Button text="Bevestigen" disable="true" styleClass="beheer-primair"/><Button text="Annuleren" onAction="#annuleerInstellingen"/></HBox>
    </VBox>
    <Label fx:id="instellingenStatus" visible="false" managed="false" styleClass="beheer-succes"/>
   </VBox>
   <VBox styleClass="beheer-kaart" spacing="16">
    <Label text="Wijzigingen" styleClass="beheer-kop"/>
    <TableView fx:id="wijzigingenTabel" prefHeight="190" fixedCellSize="48">
     <columns>
      <TableColumn fx:id="tijdstipKolom" text="Tijdstip" prefWidth="200"/><TableColumn fx:id="doorKolom" text="Door" prefWidth="260"/><TableColumn fx:id="instellingKolom" text="Instelling" prefWidth="320"/><TableColumn fx:id="oudKolom" text="Oud" prefWidth="140" styleClass="beheer-rechts"/><TableColumn fx:id="nieuwKolom" text="Nieuw" prefWidth="140" styleClass="beheer-rechts"/>
     </columns>
     <placeholder><Label text="Nog geen wijzigingen"/></placeholder>
    </TableView>
   </VBox>
   <VBox styleClass="beheer-kaart" spacing="16">
    <HBox alignment="CENTER_LEFT"><Label text="Apparaten" styleClass="beheer-kop"/><Region HBox.hgrow="ALWAYS"/><Button text="Apparaat toevoegen" onAction="#voegApparaatToe" styleClass="beheer-primair"/></HBox>
    <TableView fx:id="apparatenTabel" prefHeight="190" fixedCellSize="48">
     <columns>
      <TableColumn fx:id="naamKolom" text="Naam" prefWidth="160"/><TableColumn fx:id="typeKolom" text="Type" prefWidth="140"/><TableColumn fx:id="woningKolom" text="Woning" prefWidth="130"/><TableColumn fx:id="vermogenKolom" text="Vermogen" prefWidth="120" styleClass="beheer-rechts"/><TableColumn fx:id="magUitKolom" text="Mag uit" prefWidth="100"/><TableColumn fx:id="volgordeKolom" text="Uitzetvolgorde" prefWidth="140"/><TableColumn fx:id="nodeKolom" text="Node" prefWidth="140"/><TableColumn fx:id="actieKolom" text="" prefWidth="130" sortable="false"/>
     </columns>
     <placeholder><Label text="Geen apparaten"/></placeholder>
    </TableView>
   </VBox>
   <!-- Aansluitpunt voor Daniels gebruikersbeheer. -->
   <VBox fx:id="gebruikersSectie"/>
  </VBox>
 </content>
</ScrollPane>
