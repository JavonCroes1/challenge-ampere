<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nl.ampere.controller.ApparaatdialoogController" styleClass="beheer, beheer-dialoog" prefWidth="480" spacing="20">
 <Label fx:id="titel" text="Apparaat toevoegen" styleClass="beheer-kop"/><Separator/>
 <VBox spacing="6"><Label text="Naam" labelFor="$naam"/><TextField fx:id="naam"/></VBox>
 <HBox spacing="16">
  <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="208"><Label text="Type" labelFor="$type"/><ComboBox fx:id="type" promptText="Kies een type" maxWidth="Infinity"/></VBox>
  <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="208"><Label text="Vermogen (kW)" labelFor="$vermogen"/><TextField fx:id="vermogen"/></VBox>
 </HBox>
 <VBox spacing="6"><Label text="Woning" labelFor="$woning"/><ComboBox fx:id="woning" promptText="Kies een woning" maxWidth="Infinity"/></VBox>
 <CheckBox fx:id="magUit" text="Mag uitgezet worden" selected="true"/>
 <HBox spacing="16">
  <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="208"><Label text="Uitzetvolgorde" labelFor="$volgorde" disable="${!magUit.selected}"/><TextField fx:id="volgorde" disable="${!magUit.selected}"/></VBox>
  <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="208"><Label text="Node" labelFor="$node" disable="${!magUit.selected}"/><ComboBox fx:id="node" promptText="Kies een node" maxWidth="Infinity" disable="${!magUit.selected}"/></VBox>
 </HBox>
 <Label fx:id="fout" styleClass="beheer-fout" wrapText="true" visible="false" managed="false"/>
 <VBox fx:id="verwijderBevestiging" styleClass="beheer-bevestiging" spacing="12" visible="false" managed="false">
  <Label fx:id="verwijderVraag" wrapText="true" styleClass="beheer-kop"/>
  <HBox spacing="8"><Button text="Verwijderen" disable="true" styleClass="beheer-gevaar"/><Button text="Annuleren" onAction="#annuleerVerwijderen"/></HBox>
 </VBox>
 <Separator/>
 <HBox spacing="8" alignment="CENTER_RIGHT">
  <Button fx:id="verwijderKnop" text="Verwijderen" onAction="#vraagVerwijderen" styleClass="beheer-gevaar" visible="false" managed="false"/>
  <Region HBox.hgrow="ALWAYS"/><Button text="Annuleren" onAction="#sluiten" cancelButton="true"/><Button text="Opslaan" disable="true" styleClass="beheer-primair" defaultButton="true"/>
 </HBox>
</VBox>
